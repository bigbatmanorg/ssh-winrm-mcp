# All settings are optional. With no environment variables, the server uses stdio
# and stores inventory in the current user's normal config directory.

# Linux:   ~/.config/ssh-winrm-mcp/inventory.json
# Windows: %APPDATA%\ssh-winrm-mcp\inventory.json
# SSH_WINRM_MCP_CONFIG=/custom/path/inventory.json

# stdio (default), streamable-http, or sse.
# SSH_WINRM_MCP_TRANSPORT=stdio
# SSH_WINRM_MCP_HOST=127.0.0.1
# SSH_WINRM_MCP_PORT=8765

# Directory that uploads, downloads and local scripts are confined to.
# Default: ${XDG_DATA_HOME:-~/.local/share}/ssh-winrm-mcp/files. Set / to allow any path.
# SSH_WINRM_MCP_LOCAL_ROOT=/home/me/remote-files

# Security policy (see README "Security model").
# SSH_WINRM_MCP_ALLOWED_HOSTS=*.lab.example,10.0.110.*
# SSH_WINRM_MCP_ALLOW_ADHOC=true
# SSH_WINRM_MCP_SECRET_ENV_PATTERNS=*PASSWORD*,*PASSWD*,*_PASS,*PASSPHRASE*
# SSH_WINRM_MCP_ALLOW_INSECURE_BASIC=false

# Maximum stdout and stderr characters returned per result. 0 disables truncation.
# SSH_WINRM_MCP_MAX_OUTPUT_CHARS=200000

# Optional persistent folder for extra command-group Python modules.
# Default: beside inventory.json in a directory named commands.
# SSH_WINRM_MCP_COMMANDS_DIR=/home/me/.config/ssh-winrm-mcp/commands

# Examples for password_env references stored in inventory profiles.
# LINUX01_PASSWORD=replace-me
# WIN01_PASSWORD=replace-me
