{
  "servers": {
    "ssh-winrm": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/bigbatmanorg/ssh-winrm-mcp.git@v0.3.0",
        "ssh-winrm-mcp"
      ],
      "env": {
        "WIN01_PASSWORD": "${input:win01-password}"
      }
    }
  },
  "inputs": [
    {
      "id": "win01-password",
      "type": "promptString",
      "description": "Windows WinRM password",
      "password": true
    }
  ]
}
